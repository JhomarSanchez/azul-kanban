  "narrative": {
    "northStar": "Trabajo visible y propuestas revisables",
    "overview": "Azul es una herramienta de trabajo (Operate) construida desde código. La dirección aceptada combina azul inspirado en Windows 11, blanco y una densidad adecuada para uso frecuente en escritorio y complementario en móvil. La superficie permite leer tareas y operar sobre ellas con una jerarquía constante.\n\nLas tarjetas y columnas pertenecen al propio mundo Kanban. El gesto distintivo es el panel lateral revisable: tarea y asistente conservan el tablero como contexto. Manrope autoalojada, iconos SVG de trazo uniforme y movimiento breve acompañan acciones concretas.",
    "keyCharacteristics": [
      "Azul para acción, selección y foco sobre superficies claras.",
      "Tarjetas legibles con título, descripción breve y metadatos separados.",
      "Panel lateral que conserva el contexto del tablero.",
      "Interacción por teclado y alternativa visible al arrastre."
    ],
    "rules": [
      {
        "name": "The Acción azul Rule",
        "body": "Reservar el azul de acción para controles y estados interactivos; mantener blanco y neutros como superficies de lectura.",
        "section": "colors"
      },
      {
        "name": "The Lectura antes que densidad Rule",
        "body": "Mantener títulos de tarea de 14px, descripciones de 12px y metadatos operativos de al menos 11px; no comprimirlos al reducir el ancho.",
        "section": "typography"
      }
    ],
    "dos": [
      "Do mantener azul de acción, blanco y neutros con los roles documentados.",
      "Do conservar títulos de tarea de 14px, cuerpo de 12px y metadatos operativos de al menos 11px.",
      "Do conservar foco visible, nombres accesibles y alternativa al arrastre.",
      "Do mantener identificados la demo y el proveedor simulado.",
      "Do representar el cero sin barra y mantener el valor textual visible.",
      "Do comprobar tablero, panel de tarea, propuestas, métricas, error, vacío y móvil al extender el sistema."
    ],
    "donts": [
      "Don't usar solo el color para comunicar estado o prioridad.",
      "Don't trasladar la escala de bienvenida a las tarjetas de trabajo.",
      "Don't añadir altura mínima a barras de conteo cero.",
      "Don't declarar conformidad WCAG sin auditoría; contraste, teclado y pruebas automatizadas son evidencia parcial."
    ]
  }
