NODE_ENV=development
PORT=3000
APP_ORIGIN=http://127.0.0.1:4200
DATABASE_URL=postgresql://azul:azul_local_only@127.0.0.1:55432/azul
# Opcionales para Compose; útiles si el entorno de desarrollo ya ocupa estos puertos.
# AZUL_HTTP_PORT=3001
# AZUL_DB_PORT=55433
# DOCKER_APP_ORIGIN=http://localhost:3001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
AI_MONTHLY_BUDGET_USD=5
AI_INPUT_USD_PER_MILLION=0.75
AI_OUTPUT_USD_PER_MILLION=4.5
AI_MAX_INPUT_CHARS=16000
AI_MAX_OUTPUT_TOKENS=4000
DEMO_TTL_HOURS=24
